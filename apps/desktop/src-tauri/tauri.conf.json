{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "open-browser",
  "version": "0.1.0",
  "identifier": "com.spacecorps.open-browser",
  "build": {
    "beforeDevCommand": "pnpm --filter @spacecorps/open-browser-web dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --filter @spacecorps/open-browser-web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data:; font-src 'self'",
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "deb", "appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
